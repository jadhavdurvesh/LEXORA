cabal-version: 3.0
name: lexora-tests
version: 0.1.0.0
build-type: Simple

test-suite lexora-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test, src
  other-modules: Syntax, Lexer, Parser, Typecheck, Eval
  build-depends: base >=4.14 && <5, containers, mtl
  default-language: Haskell2010
  ghc-options: -Wall
