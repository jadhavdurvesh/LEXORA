cabal-version: 3.0
name: lexora
version: 0.1.0.0
build-type: Simple
license: MIT

executable lexora
  main-is: Main.hs
  hs-source-dirs: app, src
  other-modules: Syntax, Lexer, Parser, Typecheck, Eval, IR, IRVerify, Codegen, Optimize
  build-depends: base >=4.14 && <5, containers, mtl
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -O2

test-suite lexora-tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test, src
  other-modules: Syntax, Lexer, Parser, Typecheck, Eval, IR, IRVerify, Optimize
  build-depends: base >=4.14 && <5, containers, mtl
  default-language: Haskell2010
  ghc-options: -Wall
